include /includes/product-related-section

-
  const suggestedRings = products.catalog
    .filter((item) => item.category === 'rings')
    .slice(0, 4)

doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(
      name="description"
      content="Kapli Jewelry — корзина."
    )
    title Kapli Jewelry — Корзина
  body
    .page-shell.cart-page
      - var headerTheme = 'light'
      include /includes/header

      include /includes/cart-page

      +productRelatedSection({
        id: 'cart-suggested',
        class: 'product-related--cart-suggested',
        titleEm: '',
        titleSpan: 'Украшения могут вам понравиться',
        items: suggestedRings,
      })

      include /includes/footer

    include /includes/scripts
    +scripts()
