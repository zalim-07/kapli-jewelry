include /components/button

section.unique-banner(aria-labelledby="unique-title")
  .section-inner.unique-banner__inner
    .unique-banner__copy
      .unique-title       
        span.section-heading__title--italic Единственное 
        span.section-heading__title--regular в своём роде
      .section-heading__text
        p Некоторые украшения невозможно найти готовыми. Их можно только создать. Вместе мы разработаем дизайн, подберём камни и воплотим идею в драгоценности, которая будет существовать только в одном экземпляре.
      +uiButton({
        label: 'Создать уникальное украшение',
        variant: 'black',
        attrs: {
          'data-modal-open': 'modal-custom-jewelry',
          'aria-controls': 'modal-custom-jewelry',
        },
      })