include /components/modal
include /components/input
include /components/checkbox
include /components/button

mixin modalCustomJewelry()
  +uiModal({ id: 'modal-custom-jewelry' })
    .ui-modal__main
      .ui-modal-form
        .ui-modal-form__header
          h2.ui-modal-form__title Создайте уникальное украшение
          p.ui-modal-form__description
            | Расскажите, каким вы его представляете. Мы уточним детали, поможем подобрать камни и расскажем о сроках и стоимости.

        .ui-modal-form__fields.ui-modal-form__fields--sm
          +uiInput({
            id: 'custom-jewelry-name',
            name: 'name',
            label: 'Имя',
            placeholder: 'Мария',
          })
          +uiInput({
            id: 'custom-jewelry-phone',
            name: 'phone',
            type: 'tel',
            label: 'Телефон',
            placeholder: '+7 999 123 45 67',
          })
          +uiInput({
            id: 'custom-jewelry-idea',
            name: 'idea',
            label: 'Расскажите об идее украшения',
            placeholder: 'Камень, металл, форма, повод — всё, что для вас важно',
          })

          .ui-modal-form__upload
            span.ui-modal-form__upload-label Прикрепите фото, эскиз или референс для вдохновения
            .ui-modal-form__upload-field(data-modal-upload)
              input.ui-modal-form__upload-input(
                type="file"
                id="custom-jewelry-file"
                name="reference[]"
                accept="image/*"
                multiple
                hidden
              )
              button.ui-modal-form__upload-drop(
                type="button"
                aria-label="Загрузить изображение"
              )
                span.ui-modal-form__upload-idle
                  span.ui-modal-form__upload-icon(aria-hidden="true")
                    include ../../assets/svg/picture.svg
                  span.ui-modal-form__upload-text
                    span.ui-modal-form__upload-title.ui-modal-form__upload-title--desktop Нажмите, чтобы загрузить
                    span.ui-modal-form__upload-title.ui-modal-form__upload-title--mobile Прикрепите изображение
                    span.ui-modal-form__upload-hint или перетащите изображение украшения
              ul.ui-modal-form__upload-list(hidden)

    .ui-modal__footer
      +uiCheckbox({
        id: 'custom-jewelry-privacy',
        name: 'privacy_consent',
        size: 'sm',
        class: 'ui-modal-form__agreement',
      })
        | Нажимая на кнопку, вы соглашаетесь с&nbsp;
        a(href="/page.html") Политикой обработки и защиты персональных данных
      +uiButton({
        label: 'Обсудить украшение',
        variant: 'black',
        fullWidth: true,
        type: 'submit',
      })
