include /components/button

section.section.journal#journal(aria-labelledby="journal-title")
  .section-inner
    .section-heading.section-heading--split.journal__header
      .section-heading__title
        em Журнал 
        span Kapli Jewelry 
      +uiButton({ label: 'Смотреть всё', variant: 'black', attrs: { 'data-journal-more': true } })

    .swiper.journal-swiper
      .journal__grid.swiper-wrapper#journal-list
        article.journal-card.swiper-slide
          span.badge О камнях
          .journal-card__body
            h3 Почему не существует двух одинаковых малахитов
            p О рисунке, оттенках и природных особенностях одного из самых узнаваемых минералов.
          p.date 12/09/2024
        article.journal-card.swiper-slide
          span.badge Об уходе
          .journal-card__body
            h3 Как ухаживать за натуральными камнями
            p Что любят минералы, а чего лучше избегать.
          p.date 12/09/2024
        article.journal-card.swiper-slide
          span.badge О бренде
          .journal-card__body
            h3 За что мы любим цветные камни
            p История вдохновения, лежащая в основе каждой коллекции.
          p.date 12/09/2024
        article.journal-card.swiper-slide
          span.badge О производстве
          .journal-card__body
            h3 Почему ручная работа имеет значение
            p О том, какие этапы невозможно заменить машинным производством.
          p.date 12/09/2024
        article.journal-card.swiper-slide
          span.badge О камнях
          .journal-card__body
            h3 Как рождается цвет в минерале
            p О природных включениях, которые делают каждый камень уникальным.
          p.date 12/09/2024
        article.journal-card.swiper-slide
          span.badge О бренде
          .journal-card__body
            h3 Зачем мы собираем коллекции вокруг камня
            p Как один минерал задаёт характер всей линейки украшений.
          p.date 12/09/2024
