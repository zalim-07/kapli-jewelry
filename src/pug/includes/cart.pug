-
  const isCartFreeDelivery =
    typeof cartFreeDelivery !== 'undefined' && cartFreeDelivery
  const isCartEmpty =
    typeof cartEmpty !== 'undefined' && cartEmpty
  const cartModifiers = []

  if (isCartFreeDelivery) {
    cartModifiers.push('site-cart--free-delivery')
  }

  if (isCartEmpty) {
    cartModifiers.push('site-cart--empty')
  }

include /components/text-button
include /components/button
include /components/cart-item

aside.site-cart#site-cart(
  class=cartModifiers.length ? cartModifiers.join(' ') : false
  aria-hidden="true"
  aria-label="Корзина"
)
  button.site-cart__backdrop(type="button" aria-label="Закрыть корзину" tabindex="-1")
  .site-cart__panel
    button.site-cart__close(type="button" aria-label="Закрыть корзину")
      include ../../assets/svg/close.svg
    .site-cart__box
      .site-cart__head
        h2.site-cart__title Корзина

        if !isCartEmpty
          .site-cart__head-actions
            +uiTextButton({ label: 'Очистить корзину', class: 'site-cart__clear' })

      if isCartEmpty
        .site-cart__empty
          .site-cart__empty-content
            .site-cart__empty-icon(aria-hidden="true")
              include ../../assets/svg/cart-cross.svg
            p.site-cart__empty-title
              | В корзине пока 
              em нет украшений
            p.site-cart__empty-text
              | Продолжите знакомство с коллекциями 
              br
              | Kapli Jewelry в каталоге.
          +uiButton({
            label: 'Перейти в каталог',
            variant: 'black',
            href: '#collections',
            class: 'site-cart__empty-action',
          })
      else
        .site-cart__progress(
          data-cart-progress
          style=isCartFreeDelivery ? false : '--cart-progress: 87%'
        )
          .site-cart__progress-labels
            span.site-cart__progress-label платная доставка
            button.site-cart__progress-label.site-cart__progress-label--free(
              type="button"
              disabled=isCartFreeDelivery ? null : true
            ) бесплатная доставка
          .site-cart__progress-track
            .site-cart__progress-fill
              span.site-cart__progress-arrow(aria-hidden="true")
          .site-cart__progress-values
            span 0 ₽
            span 12 000 ₽

        .site-cart__body
          +uiCartItem({
            title: 'Кольцо Росток',
            image: '/src/assets/images/products/product-1.png',
            size: '16',
            oldPrice: '18 204 ₽',
            price: '10 255 ₽',
          })
          +uiCartItem({
            title: 'Серьги Капля',
            image: '/src/assets/images/products/product-2.png',
            size: '—',
            oldPrice: '18 200 ₽',
            price: '10 255 ₽',
          })
          +uiCartItem({
            title: 'Кольцо Росток',
            image: '/src/assets/images/products/product-3.png',
            size: '16',
            oldPrice: '18 204 ₽',
            price: '10 255 ₽',
          })
          +uiCartItem({
            title: 'Кольцо Росток',
            image: '/src/assets/images/products/product-4.png',
            size: '16',
            oldPrice: '18 204 ₽',
            price: '10 255 ₽',
          })

        .site-cart__footer
          .site-cart__footer-col.site-cart__footer-cols
            .site-cart__footer-col
              span.site-cart__footer-label До скидки
              span.site-cart__footer-value.site-cart__footer-value--old 36 404 ₽
            .site-cart__footer-col
              span.site-cart__footer-label Итого
              span.site-cart__footer-value 20 510 ₽
          .site-cart__footer-col
            +uiButton({
              label: 'Перейти к оформлению',
              variant: 'black',
              href: '/checkout.html',
              fullWidth: true,
              class: 'site-cart__checkout',
            })
