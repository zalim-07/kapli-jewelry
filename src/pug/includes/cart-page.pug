include /components/input
include /components/button
include /components/text-button
include /components/cart-item

main.cart-page__main
  .cart-page__header
    .cart-page__header-inner
      h1.cart-page__title Корзина
      .cart-page__toolbar
        p.cart-page__count 2 украшения
        +uiTextButton({ label: 'Очистить корзину', class: 'cart-page__clear' })

  .cart-page__layout
    .cart-page__primary
      .cart-page__items
        +uiCartItem({
          title: 'Кольцо Росток',
          image: '/src/assets/images/products/product-1.png',
          size: '16',
          oldPrice: '18 204 ₽',
          price: '10 255 ₽',
          status: false,
        })
        +uiCartItem({
          title: 'Серьги Капля',
          image: '/src/assets/images/products/product-2.png',
          size: '—',
          oldPrice: '18 204 ₽',
          price: '10 255 ₽',
          status: false,
        })
        +uiCartItem({
          title: 'Серьги Капля',
          image: '/src/assets/images/products/product-2.png',
          size: '—',
          oldPrice: '18 204 ₽',
          price: '10 255 ₽',
          status: false,
        })

      p.cart-page__note Корзина автоматически очистится через 24 часа

    aside.cart-page__aside
      form.cart-page__promo(action="#" method="post")
        +uiInput({
          id: 'cart-promo',
          name: 'promo',
          label: 'Промокод',
          placeholder: 'Введите промокод',
          size: 'md',
        })

      .cart-page__order
        h2.cart-page__order-title Ваш заказ

        .cart-page__order-rows
          .cart-page__order-row
            span Товары
            strong 36 408 ₽
          .cart-page__order-row
            span Скидка
            strong − 15 892 ₽
          .cart-page__order-row
            span Доставка
            span Бесплатно

        .cart-page__order-total
          span Сумма заказа:
          strong 20 510 ₽

        +uiButton({
          label: 'Оформить заказ',
          variant: 'black',
          href: '/checkout.html',
          fullWidth: true,
          class: 'cart-page__checkout',
        })

        .cart-page__installments
          .cart-page__installments-caption
            span.cart-page__installments-text 4 платежа x 2 404 ₽
            button.cart-page__installments-info(
              type="button"
              aria-label="Подробнее об оплате частями"
            )
              include ../../assets/svg/question.svg
          .cart-page__installments-logos(aria-label="Сервисы оплаты частями")
            span.cart-page__installments-logo.cart-page__installments-logo--podeli(aria-label="Подели")
              include ../../assets/svg/payment-podeli-black-logo.svg
            span.cart-page__installments-logo.cart-page__installments-logo--dolyame(aria-label="Долями")
              include ../../assets/svg/payment-dolyami.svg
            span.cart-page__installments-logo.cart-page__installments-logo--split(aria-label="Сплит")
              include ../../assets/svg/payment-split.svg
