-
  const resolvedHeaderTheme =
    typeof headerTheme !== 'undefined' ? headerTheme : null

header.site-header(
  class=resolvedHeaderTheme === 'light' ? 'site-header--light' : resolvedHeaderTheme === 'dark' ? 'site-header--dark' : false
  data-theme=resolvedHeaderTheme
)
  .site-header__inner
    button.site-header__menu(
      type="button"
      aria-label="Открыть меню"
      aria-expanded="false"
      aria-controls="site-sidemenu"
    )
      include ../../assets/svg/menu-linear.svg

    nav.site-header__nav(aria-label="Основная навигация")
      ul#menu-primary.menu
        li.menu-item.menu-item-type-custom.menu-item-object-custom
          a(href="#collections") Каталог
        li.menu-item.menu-item-type-custom.menu-item-object-custom
          a(href="#catalog") Бестселлеры
        li.menu-item.menu-item-type-custom.menu-item-object-custom
          a(href="#journey") Производство
        li.menu-item.menu-item-type-custom.menu-item-object-custom
          a(href="#journal") Журнал

    a.site-header__logo(href="/" aria-label="Kapli Jewelry, главная")
      span.site-header__logo-desktop(aria-hidden="true")
        include ../../assets/svg/logo-mobile.svg
      span.site-header__logo-mobile(aria-hidden="true")
        include ../../assets/svg/logo-mobile.svg

    .site-header__actions
      .site-header__contacts
        button.site-header__action.site-header__action--contacts(
          type="button"
          aria-label="Контакты"
          aria-expanded="false"
          aria-controls="header-contacts-popup"
        )
          span.site-header__icon.site-header__icon--phone(aria-hidden="true")
          span.site-header__action-text Контакты
        .site-header__contacts-popup#header-contacts-popup(
          aria-hidden="true"
          role="dialog"
          aria-label="Контакты"
        )
          .site-header__contacts-popup-box
            .site-header__contacts-item
              a.site-header__contacts-value(href="tel:+79252969444") +7 925 296 94 44
              p.site-header__contacts-note Будем рады вашему звонку
            .site-header__contacts-item
              a.site-header__contacts-value(href="mailto:info@kapli-jewelry.ru") info@kapli-jewelry.ru
              p.site-header__contacts-note Напишите нам
      button.site-header__action.site-header__action--cart(
        type="button"
        aria-label="Корзина"
        aria-expanded="false"
        aria-controls="site-cart"
      )
        span.site-header__icon.site-header__icon--bag(aria-hidden="true")
        span.site-header__action-text Корзина

aside.site-sidemenu#site-sidemenu(aria-hidden="true" aria-label="Меню")
  button.site-sidemenu__backdrop(type="button" aria-label="Закрыть меню" tabindex="-1")
  .site-sidemenu__panel
    .site-sidemenu__inner
      .site-sidemenu__top
        .site-sidemenu__head
          a.site-sidemenu__logo(href="/home.html" aria-label="Kapli Jewelry, главная")
            include ../../assets/svg/logo.svg
          button.site-sidemenu__close(type="button" aria-label="Закрыть меню")
            include ../../assets/svg/close.svg
        .site-sidemenu__menu
          h2.site-sidemenu__title Меню
          nav.site-sidemenu__nav(aria-label="Основная навигация")
            ul.menu
              li.menu-item
                a(href="#collections") Каталог
              li.menu-item
                a(href="#catalog") Бестселлеры
              li.menu-item
                a(href="#journey") Производство
              li.menu-item
                a(href="#journal") Журнал
      .site-sidemenu__bottom
        .site-sidemenu__contacts-item
          a.site-sidemenu__contacts-value(href="tel:+79252969444") +7 925 296 94 44
          p.site-sidemenu__contacts-note Будем рады вашему звонку
        .site-sidemenu__contacts-item
          a.site-sidemenu__contacts-value(href="mailto:info@kapli-jewelry.ru") info@kapli-jewelry.ru
          p.site-sidemenu__contacts-note Напишите нам

include /includes/cart
