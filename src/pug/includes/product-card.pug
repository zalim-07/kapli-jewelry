mixin productCard(product, options = {})
  - const cardOptions = options && typeof options === 'object' ? options : {}
  - const productHref = product.href || '#'
  - const images = Array.isArray(product.images) ? product.images : []
  - const sizes = Array.isArray(product.sizes) ? product.sizes : []
  - const badges = Array.isArray(product.badges) ? product.badges : []
  - const kamenValues = Array.isArray(product.kamen) ? product.kamen : (product.kamen ? [product.kamen] : [])
  - const materialValues = Array.isArray(product.material) ? product.material : (product.material ? [product.material] : [])
  - const materials = [...kamenValues, ...materialValues]
  - const categories = Array.isArray(product.categories) ? product.categories : (product.category ? [product.category] : [])
  - const categoriesAttr = categories.length ? categories.join(' ') : null
  - const visibleSizesCount = 6
  - const querySeparator = productHref.includes('?') ? '&' : '?'
  - const cardClass = cardOptions.large ? 'product-card product-card--large' : 'product-card'

  article(
    class=cardClass
    data-product-card
    data-categories=categoriesAttr
  )
    .product-card__media
      a.product-card__media-link(
        href=productHref
        aria-label=`Открыть товар «${product.title}»`
        tabindex="-1"
        aria-hidden="true"
      )

      if images.length
        .product-card__images
          each image, index in images
            img.product-card__image(
              class=index === 0 ? 'is-active' : null
              src=image.src
              alt=index === 0 ? (image.alt || product.title) : ''
              width="720"
              height="950"
              loading=cardOptions.eager && index === 0 ? 'eager' : 'lazy'
              aria-hidden=index === 0 ? null : 'true'
            )

      if badges.length
        ul.product-card__badges(aria-label="Особенности товара")
          each badge in badges
            li.product-card__badge= badge

      if sizes.length
        .product-card__sizes(data-product-sizes)
          each size, index in sizes
            a.product-card__size(
              class=index >= visibleSizesCount ? 'product-card__size--hidden' : null
              href=`${productHref}${querySeparator}size=${encodeURIComponent(size)}`
              data-product-size=size
              aria-label=`Открыть товар в размере ${size}`
            )= size

          if sizes.length > visibleSizesCount
            button.product-card__sizes-more(
              type="button"
              data-product-sizes-more
              aria-expanded="false"
              aria-label="Показать все размеры"
            )
              span(aria-hidden="true") …

      if images.length > 1
        .product-card__zones(data-product-zones aria-hidden="true")
          each image, index in images
            span.product-card__zone(data-product-zone=index)

    if images.length > 1
      .product-card__dots(data-product-dots aria-hidden="true")
        each image, index in images
          span.product-card__dot(class=index === 0 ? 'is-active' : null)

    .product-card__info      
      .product-card__header
        h3.product-card__title
          a.product-card__title-link(href=productHref)= product.title
        if product.price
          p.product-card__price= product.price
      
      if materials.length
        p.product-card__material
          each material, index in materials
            if index > 0
              span.product-card__material-separator(aria-hidden="true")
            = material

      