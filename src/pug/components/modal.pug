mixin uiModalCloseIcon()
  include ../../assets/svg/close.svg

mixin uiModal(options = {})
  - const id = options.id || 'modal'
  - const className = [options.class || null].filter(Boolean).join(' ')

  .ui-modal(
    id=id
    class=className
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    hidden
  )
    .ui-modal__overlay(data-modal-close tabindex="-1")
    .ui-modal__dialog
      .ui-modal__head
        button.ui-modal__close(
          type="button"
          aria-label="Закрыть"
          data-modal-close
        )
          +uiModalCloseIcon()
      if block
        block
