mixin uiInputInfoIcon()
  include ../../assets/svg/info.svg

mixin uiInput(options = {})
  - const id = options.id || options.name || 'input'
  - const type = options.type || 'text'
  - const size = options.size || 'md'
  - const style = options.style || 'outline'
  - const disabled = options.disabled || false
  - const hasError = options.error || false
  - const hasTooltip = Boolean(options.tooltip)
  - const tooltipText = typeof options.tooltip === 'string' ? options.tooltip : (options.tooltipText || options.tooltipLabel || 'Подсказка')
  - const className = ['ui-input-field', `ui-input-field--${size}`, `ui-input-field--${style}`, hasError ? 'ui-input-field--error' : null, disabled ? 'ui-input-field--disabled' : null, options.class || null].filter(Boolean).join(' ')

  .ui-input-field(class=className)
    if options.label
      .ui-input-field__label-row
        label.ui-input-field__label(for=id)= options.label
    .ui-input-field__content
      input.ui-input-field__control(
        type=type
        id=id
        name=options.name || id
        value=options.value
        placeholder=options.placeholder
        disabled=disabled ? true : null
        required=options.required ? true : null
        aria-invalid=hasError ? 'true' : null
      )
      if hasTooltip
        span.ui-input-field__info-wrap
          button.ui-input-field__info(
            type="button"
            aria-label=options.tooltipLabel || tooltipText
            aria-describedby=`${id}-tooltip`
          )
            +uiInputInfoIcon()
          span.ui-input-field__tooltip(id=`${id}-tooltip` role="tooltip")= tooltipText
