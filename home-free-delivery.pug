- const cartFreeDelivery = true

doctype html
html(lang="ru")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(
      name="description"
      content="Kapli Jewelry - украшения с натуральными камнями ручной работы."
    )
    title Kapli Jewelry — бесплатная доставка
  body
    .page-shell.home-page
      include /includes/header

      main
        include /includes/hero
        include /includes/featured
        include /includes/collections
        include /includes/journey
        include /includes/unique-banner
        include /includes/numbers
        include /includes/gift
        include /includes/journal

      include /includes/footer

    include /includes/modal-custom-jewelry
    include /includes/modal-gift-certificate
    +modalCustomJewelry()
    +modalGiftCertificate()

    include /includes/scripts
    +scripts(['/src/js/home-page.js'])
